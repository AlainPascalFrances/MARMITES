# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.spyproject/
.ipynb_checkpoints/

# --- MODFLOW / MARMITES model workspaces (large, regenerable) ---
# MF_ws is a mix: keep the ASCII inputs, the parameter sets and the reusable
# spin-up state; drop the MODFLOW-NWT model files, checks and run outputs.
DataSet_*/MF_ws/*
!DataSet_*/MF_ws/*.asc
!DataSet_*/MF_ws/*.ASC
!DataSet_*/MF_ws/*.ini
!DataSet_*/MF_ws/*.txt
DataSet_*/MF6_ws/
DataSet_*/MF6_ws_disv/
# MMsurf_ws: keep the MMsurf INPUTS (parameter ini, meteo and irrigation
# series, crop schedule); drop what MMsurf generates (.out/.int/.png) and
# the 10 MB raw meteo spreadsheet (kept in the legacy archive).
DataSet_*/MMsurf_ws/*
!DataSet_*/MMsurf_ws/*.ini
!DataSet_*/MMsurf_ws/*.txt
!DataSet_*/MMsurf_ws/*.xlsx

# --- model outputs / binaries ---
*.h5
*.hds
*.cbc
*.grb
*.lst

# --- post-processing products ---
**/postproc/
**/preproc/
**/figures/
