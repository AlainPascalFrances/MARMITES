# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.spyproject/
.ipynb_checkpoints/

# --- Safety net ---
# Run output goes to the WORKSPACE (default E:/00code_ws/LaMata_MM-MF6),
# not into this repository, which holds code + input data + docs only --
# "input data" meaning the files MM and MF read directly, nothing else.
# These rules remain so a stray or legacy run cannot pollute the tree.
# MF_ws is a mix: keep the ASCII inputs, the parameter sets and the reusable
# spin-up state; drop the MODFLOW-NWT model files, checks and run outputs.
example/*/MF_ws/*
!example/*/MF_ws/*.asc
!example/*/MF_ws/*.ASC
!example/*/MF_ws/*.ini
!example/*/MF_ws/*.txt
example/*/MF6_ws/
example/*/MF6_ws_disv/
# GIS: source cartography, not model input. Nothing in MM or MF reads a
# shapefile; the general map reads them straight from the workspace
# (E:/00code_ws/LAMATA_new/GIS, or --gis-ws).
example/*/GIS/
# MMsurf_ws: keep the MMsurf INPUTS (parameter ini, meteo and irrigation
# series, crop schedule); drop what MMsurf generates (.out/.int/.png) and
# the 10 MB raw meteo spreadsheet (kept in the legacy archive).
example/*/MMsurf_ws/*
!example/*/MMsurf_ws/*.ini
!example/*/MMsurf_ws/*.txt
!example/*/MMsurf_ws/*.xlsx

# --- model outputs / binaries ---
*.h5
*.hds
*.cbc
*.grb
*.lst

# --- post-processing products ---
**/_input/
**/_output/
**/figures_nwt_comparison/
**/postproc/
**/preproc/
**/figures/

# --- IDE / editor / legacy environment (dropped on this branch; still on MM-MF6) ---
.idea/
_windows/
codestyles/
inspection/
keymaps/
venv/
*.psproj
